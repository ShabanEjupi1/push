<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.0" xmlns="http://java.sun.com/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/persistence http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd">
  <persistence-unit name="warehouse_PU" transaction-type="JTA">
    <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
    <jta-data-source>jdbc/kcustoms</jta-data-source>
    <exclude-unlisted-classes>false</exclude-unlisted-classes>
    <properties>
      <!-- FINE + logging.parameters=true wrote every SQL statement AND every bound
           parameter value into server.log. On a production box that (a) grows the log
           without bound, which is a real cause of the server dying after a few days,
           and (b) puts trader/warehouse data and password hashes on disk in clear.
           Set back to FINE only for short, deliberate debugging sessions. -->
      <property name="eclipselink.logging.level" value="WARNING"/>
      <property name="eclipselink.logging.parameters" value="false"/>
    </properties>
  </persistence-unit>
</persistence>
